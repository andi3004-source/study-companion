APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Anthropic API key for the AI Conversation Partner feature (currently NOT
# the active provider — see GEMINI_API_KEY below — but kept configured so
# switching back is just a binding change in AppServiceProvider). Backend
# only — read by AnthropicClient, never sent to Blade/JS.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini API key for the AI Conversation Partner feature (active provider) —
# also reused by GeminiMeaningTranslator (see `php artisan translate:meanings`)
# to fill in mandarin_hsk_words.meaning_id / english_vocab.translations.id,
# so no separate paid translation API is needed for that. Free tier Google AI
# Studio — CATATAN: prompt & respons di tier gratis bisa dipakai Google buat
# improve produk mereka. Upgrade ke billing kalau butuh privasi data penuh.
# Backend only — read by GeminiClient, never sent to Blade/JS. Leave empty to
# disable both features (they fail with a clear error instead of a crash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Pronunciation checker microservice (FastAPI, wraps OpenPronounce for
# English and tone-me for Mandarin — see pronunciation-service/). 'ml' calls
# it and auto-falls-back to SttMatchPronunciationChecker (free, local) if
# it's unreachable; set 'stt_match' here to skip the ML service entirely.
PRONUNCIATION_SERVICE_URL=http://localhost:8001
PRONUNCIATION_CHECKER_DRIVER=ml

# Optional: path to the hand-checked HSK2-3 corrections file read by
# MandarinHskSeeder and `php artisan hsk:apply-corrections` (see config/hsk.php).
# Defaults to storage/app/seed-data/hsk1to3_kosakata_id.json.
# HSK_CORRECTIONS_PATH=

# Conversation Partner: lock Mandarin replies to the HSK1 vocabulary list
# (adds the list to every Mandarin system prompt — see README for the token
# cost). Set to false to turn it off.
HSK_LEVEL_LOCK=true

# Optional IBM Langflow flow for the end-of-session error analysis
# ("Kesalahan terbanyakmu"). Leave LANGFLOW_URL/LANGFLOW_FLOW_ID empty to use
# Gemini; when set, Gemini is still the fallback if a Langflow call fails.
# LANGFLOW_URL is the base URL (a trailing / or /api is stripped).
# LANGFLOW_TIMEOUT is in seconds (default 120; one analysis has taken ~74s).
LANGFLOW_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=120

# Optional demo account for reviewers running the app LOCALLY (never in
# production). Create it with: php artisan db:seed --class=DemoUserSeeder
# Use a password made only for the demo — never one used anywhere else.
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@studycompanion.test
DEMO_ACCOUNT_PASSWORD=ganti-dengan-kata-sandi-demo
